# panel — example env. copy to `.env` for local dev. systemd-user override.conf is the prod source.

# REQUIRED. HMAC secret for attestation tokens. rotate by restarting the service.
# generate: openssl rand -hex 32
PANEL_SIGNING_SECRET=dev-insecure-secret-change-me

# REQUIRED. comma-separated allowlist of operator site keys.
PANEL_SITE_KEYS=pk_demo_a,pk_demo_b

# OPTIONAL. absolute path to the sqlite db. default: ./data/panel.db
# PANEL_DB_PATH=/home/ubuntu/panel/data/panel.db

# OPTIONAL. log dir for JSON-line access log. default: ./logs
# PANEL_LOG_DIR=/home/ubuntu/panel/logs

# OPTIONAL. per-site-key origin allowlist for CORS. format:
# PANEL_KEY_ORIGINS_<UPPER_KEY_NORMALIZED>=https://a.com,https://b.com
# (only used for non-demo keys; demo keys get permissive *)
# PANEL_KEY_ORIGINS_PK_LIVE_FOO=https://customer.example.com

# OPTIONAL. backup config (used by scripts/backup.sh + panel-backup.timer)
# PANEL_BACKUP_DIR=/home/ubuntu/panel/data/backups
# PANEL_BACKUP_RETENTION_DAYS=7

# OPTIONAL. version string surfaced by /api/health.
# PANEL_VERSION=0.1.0
