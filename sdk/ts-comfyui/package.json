{
  "name": "panel-comfyui-adapter",
  "version": "0.1.0",
  "description": "first-party adapter: drive a ComfyUI instance and emit outputs to panel",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-cjs.mjs",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-tests/__tests__/*.test.js'",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "panel-sdk": "file:../ts",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3"
  }
}
